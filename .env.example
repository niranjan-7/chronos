# Chronos Core Environment Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL Database
POSTGRES_USER=chronos
POSTGRES_PASSWORD=chronos_secret
POSTGRES_DB=chronos_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chronos:chronos_secret@localhost:5432/chronos_db?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0

# Security & JWT
JWT_SECRET=chronos-super-secret-jwt-key-32-chars-min!
JWT_EXPIRES_IN=1d
