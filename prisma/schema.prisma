datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ONBOARDING
}

enum UserRole {
  TENANT_ADMIN
  AGENT
  SUPERVISOR
  SYSTEM
}

enum AgentStatus {
  ONLINE
  OFFLINE
  BUSY
  AWAY
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WebhookDeliveryStatus {
  SUCCESS
  PENDING_RETRY
  DEAD_LETTER
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  DEAD_LETTER
}

enum RoutingMode {
  PULL_QUEUE
  AUTO_PUSH
}

enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(255)
  slug      String       @unique @db.VarChar(100)
  status    TenantStatus @default(ACTIVE)
  config    Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                User[]
  slaPolicies          SlaPolicy[]
  tickets              Ticket[]
  ticketAuditLogs      TicketAuditLog[]
  webhookSubscriptions WebhookSubscription[]
  webhookDeliveryLogs  WebhookDeliveryLog[]
  businessCalendar     BusinessCalendar?
  holidays             TenantHoliday[]
  outboxEvents         OutboxEvent[]
  agentSkills          AgentSkill[]
  webhookEndpoints     WebhookEndpoint[]
  webhookDeliveryAttempts WebhookDeliveryAttempt[]

  @@map("tenants")
}

model User {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  email     String      @db.VarChar(255)
  name      String      @db.VarChar(255)
  role      UserRole    @default(AGENT)
  status    AgentStatus @default(OFFLINE)
  skills               String[]         @default([])
  maxConcurrentTickets Int              @default(5) @map("max_concurrent_tickets")
  metadata             Json             @default("{}")
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedTickets Ticket[]         @relation("AssignedAgent")
  ticketAuditLogs TicketAuditLog[]
  agentSkills     AgentSkill[]

  @@unique([tenantId, email], name: "uq_tenant_user_email")
  @@index([tenantId, role, status], name: "idx_users_tenant_role_status")
  @@index([tenantId, email], name: "idx_users_tenant_email")
  @@index([tenantId, status], name: "idx_users_tenant_status")
  @@map("users")
}

model SlaPolicy {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  name                  String         @db.VarChar(255)
  description           String?        @db.Text
  priority              TicketPriority
  responseTimeMinutes   Int            @map("response_time_minutes")
  resolutionTimeMinutes Int            @map("resolution_time_minutes")
  isActive              Boolean        @default(true) @map("is_active")
  version               Int            @default(1)
  conditions            Json           @default("{}")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([tenantId, priority, isActive], name: "idx_sla_tenant_priority_active")
  @@index([tenantId, isActive], name: "idx_sla_tenant_active")
  @@map("sla_policies")
}

model Ticket {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  ticketNumber       String         @map("ticket_number") @db.VarChar(64)
  title              String         @db.VarChar(255)
  description        String         @db.Text
  status             TicketStatus   @default(OPEN)
  priority           TicketPriority @default(MEDIUM)
  routingMode        RoutingMode    @default(PULL_QUEUE) @map("routing_mode")
  requiredSkills     String[]       @default([]) @map("required_skills")
  assignedAgentId    String?        @map("assigned_agent_id") @db.Uuid
  slaPolicyId        String?        @map("sla_policy_id") @db.Uuid
  metadata           Json           @default("{}")
  isBreached         Boolean        @default(false) @map("is_breached")
  isWarningSent      Boolean        @default(false) @map("is_warning_sent")
  pausedAt           DateTime?      @map("paused_at") @db.Timestamptz(6)
  slaPausedAt        DateTime?      @map("sla_paused_at") @db.Timestamptz(6)
  lastResumedAt      DateTime?      @map("last_resumed_at") @db.Timestamptz(6)
  remainingSlaMs     BigInt?        @map("remaining_sla_ms")
  policyVersion      Int            @default(1) @map("policy_version")
  firstResponseDueAt DateTime?      @map("first_response_due_at") @db.Timestamptz(6)
  firstResponseAt    DateTime?      @map("first_response_at") @db.Timestamptz(6)
  resolutionDueAt    DateTime?      @map("resolution_due_at") @db.Timestamptz(6)
  resolvedAt         DateTime?      @map("resolved_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedAgent   User?            @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  slaPolicy       SlaPolicy?       @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  ticketAuditLogs TicketAuditLog[]

  @@unique([tenantId, ticketNumber], name: "uq_tenant_ticket_number")
  @@index([tenantId, status, priority], name: "idx_tickets_tenant_status_priority")
  @@index([tenantId, assignedAgentId, status], name: "idx_tickets_tenant_agent_status")
  @@index([tenantId, slaPolicyId], name: "idx_tickets_tenant_sla_policy")
  @@index([tenantId, resolutionDueAt], name: "idx_tickets_tenant_resolution_due")
  @@index([tenantId, createdAt], name: "idx_tickets_tenant_created_at")
  @@map("tickets")
}

model TicketAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(100)
  changes   Json     @default("{}")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, ticketId, createdAt], name: "idx_audit_tenant_ticket_created")
  @@index([tenantId, actorId], name: "idx_audit_tenant_actor")
  @@index([tenantId, action], name: "idx_audit_tenant_action")
  @@map("ticket_audit_logs")
}

model WebhookSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  url       String   @db.VarChar(1024)
  secret    String   @db.VarChar(255)
  events    String[] @default([])
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryLogs WebhookDeliveryLog[]

  @@index([tenantId, isActive], name: "idx_webhooks_tenant_active")
  @@map("webhook_subscriptions")
}

model WebhookDeliveryLog {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  subscriptionId String                @map("subscription_id") @db.Uuid
  event          String                @db.VarChar(100)
  payload        Json
  attempts       Int                   @default(1)
  statusCode     Int?                  @map("status_code")
  responseBody   String?               @map("response_body") @db.Text
  status         WebhookDeliveryStatus @default(PENDING_RETRY)
  lastError      String?               @map("last_error") @db.Text
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, status], name: "idx_webhook_delivery_tenant_status")
  @@index([tenantId, createdAt], name: "idx_webhook_delivery_tenant_created")
  @@map("webhook_delivery_logs")
}

model BusinessCalendar {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  name           String   @default("Default Business Calendar") @db.VarChar(255)
  timezone       String   @default("UTC") @db.VarChar(100)
  weeklySchedule Json     @default("{\"monday\":[{\"start\":\"09:00\",\"end\":\"17:00\"}],\"tuesday\":[{\"start\":\"09:00\",\"end\":\"17:00\"}],\"wednesday\":[{\"start\":\"09:00\",\"end\":\"17:00\"}],\"thursday\":[{\"start\":\"09:00\",\"end\":\"17:00\"}],\"friday\":[{\"start\":\"09:00\",\"end\":\"17:00\"}],\"saturday\":[],\"sunday\":[]}")
  is24x7         Boolean  @default(false) @map("is_24x7")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], name: "idx_calendar_tenant")
  @@map("business_calendars")
}

model TenantHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(255)
  date      String   @db.VarChar(10) // Format: YYYY-MM-DD
  isFullDay Boolean  @default(true) @map("is_full_day")
  startTime String?  @map("start_time") @db.VarChar(5) // Format: HH:mm
  endTime   String?  @map("end_time") @db.VarChar(5)   // Format: HH:mm
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date], name: "idx_holidays_tenant_date")
  @@map("tenant_holidays")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(64)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(128)
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)
  error         String?      @db.Text

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt], name: "idx_outbox_status_next_attempt")
  @@index([tenantId, status], name: "idx_outbox_tenant_status")
  @@map("outbox_events")
}

model AgentSkill {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  agentId     String   @map("agent_id") @db.Uuid
  skill       String   @db.VarChar(100)
  proficiency Int      @default(1) // 1 to 5
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  User   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, skill], name: "uq_agent_skill")
  @@index([tenantId, skill], name: "idx_agent_skills_tenant_skill")
  @@map("agent_skills")
}

model WebhookEndpoint {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  url              String       @db.VarChar(1024)
  signingSecret    String       @map("signing_secret") @db.VarChar(512)
  subscribedEvents String[]     @default(["sla.warning", "sla.breach", "ticket.escalated"]) @map("subscribed_events")
  isActive         Boolean      @default(true) @map("is_active")
  circuitState     CircuitState @default(CLOSED) @map("circuit_state")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryAttempts WebhookDeliveryAttempt[]

  @@index([tenantId, isActive], name: "idx_webhook_endpoints_tenant_active")
  @@index([tenantId, circuitState], name: "idx_webhook_endpoints_circuit")
  @@map("webhook_endpoints")
}

model WebhookDeliveryAttempt {
  id                     String                @id @default(uuid()) @db.Uuid
  tenantId               String                @map("tenant_id") @db.Uuid
  endpointId             String                @map("endpoint_id") @db.Uuid
  event                  String                @db.VarChar(100)
  payload                Json
  attemptNumber          Int                   @default(1) @map("attempt_number")
  statusCode             Int?                  @map("status_code")
  responseLatencyMs      Int?                  @map("response_latency_ms")
  responseBody           String?               @map("response_body") @db.Text
  status                 WebhookDeliveryStatus @default(PENDING_RETRY)
  errorMessage           String?               @map("error_message") @db.Text
  circuitStateAtDispatch CircuitState?         @map("circuit_state_at_dispatch")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, status], name: "idx_webhook_attempts_tenant_status")
  @@index([endpointId, status], name: "idx_webhook_attempts_endpoint_status")
  @@index([tenantId, createdAt], name: "idx_webhook_attempts_tenant_created")
  @@map("webhook_delivery_attempts")
}



